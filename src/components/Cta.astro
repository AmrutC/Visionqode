---
import { site } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Have a process that should run itself?', text = `Tell us what slows the business down. We reply ${site.replyTime}, and the first conversation is free.` } = Astro.props;
---
<section class="section cta" data-theme="navy">
  <div class="container cta__inner">
    <h2 class="display-xl reveal-clip">{title}</h2>
    <p class="body-l text-secondary measure-narrow reveal">{text}</p>
    <div class="cta__actions reveal">
      <a class="btn btn--primary" href="/contact" data-magnetic>Start a project</a>
      <a class="btn btn--secondary" href={site.whatsapp} target="_blank" rel="noopener">WhatsApp {site.phone}</a>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--grad-navy); position: relative; overflow: hidden; }
  .cta::after { content: ''; position: absolute; left: -10%; top: -40%; width: 40vw; height: 40vw; max-width: 520px; max-height: 520px; border-radius: 50%; background: radial-gradient(closest-side, rgba(212,172,92,.25), transparent); pointer-events: none; }
  .cta::before { content: ''; position: absolute; inset: auto -10% -60% auto; width: 60vw; height: 60vw; max-width: 720px; max-height: 720px; border-radius: 50%; border: 1px dashed var(--border-default); pointer-events: none; }
  .cta__inner { display: grid; gap: var(--space-5); justify-items: start; position: relative; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-3); }
</style>
