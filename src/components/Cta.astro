---
import { site } from '../data/site';
import Icon from './Icon.astro';
interface Props { title?: string; text?: string }
const { title = 'Have a process that should run itself?', text = `Tell us what slows the business down. We reply ${site.replyTime}, and the first conversation is free.` } = Astro.props;
---
<section class="cta" id="contact" data-theme="navy" data-nav-dark data-zone>
  <div class="aurora aurora--soft" aria-hidden="true"><i></i><i></i><i></i></div>
  <span class="cta__ring cta__ring--1" aria-hidden="true"></span><span class="cta__ring cta__ring--2" aria-hidden="true"></span><span class="cta__glow" aria-hidden="true"></span>
  <div class="container cta__inner">
    <h2 class="display-xl reveal cta__title">{title}</h2>
    <p class="body-l text-secondary measure-narrow reveal">{text}</p>
    <div class="cta__actions reveal">
      <a class="btn btn--primary" href="/contact" data-magnetic>Book a free call <Icon name="arrowUp" size={16} /></a>
      <a class="btn btn--secondary" href={site.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /> WhatsApp {site.phone}</a>
    </div>
  </div>
</section>
<style>
  .cta { position: relative; isolation: isolate; overflow: hidden; color: var(--text-primary); background: linear-gradient(180deg, #1c2348 0%, #141a38 60%, var(--navy-900) 100%); border-radius: var(--radius-xl) var(--radius-xl) 0 0; padding-block: clamp(72px, 9vw, 128px) clamp(56px, 7vw, 96px); scroll-margin-top: 80px; }
  .cta__glow { position: absolute; left: -8%; top: -50%; width: 46vw; height: 46vw; max-width: 600px; max-height: 600px; border-radius: 50%; background: radial-gradient(closest-side, rgba(212,172,92,.22), transparent); pointer-events: none; }
  .cta__ring { position: absolute; right: -6%; top: 50%; border-radius: 50%; border: 1px solid rgba(255,255,255,.08); pointer-events: none; translate: 0 -50%; }
  .cta__ring--1 { width: 520px; height: 520px; }
  .cta__ring--2 { width: 820px; height: 820px; right: calc(-6% - 150px); border-style: dashed; animation: spin 90s linear infinite; }
  @keyframes spin { to { rotate: 360deg; } }
  .cta__inner { display: grid; gap: var(--space-4); justify-items: start; position: relative; }
  .cta__title { max-width: 11em; font-size: clamp(2.6rem, 1rem + 5.6vw, 5.75rem); letter-spacing: -0.045em; line-height: 1; background: linear-gradient(100deg, #fff 30%, #f0d9a6 70%, var(--gold-600)); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: .1em; }
  .cta__title :global(.w) { padding-bottom: .2em; margin-bottom: -.2em; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
</style>
