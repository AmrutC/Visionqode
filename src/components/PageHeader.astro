---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { title: string; lede?: string; crumbs?: { name: string; href: string }[]; eyebrow?: string; theme?: 'light' | 'ink' }
const { title, lede, crumbs = [], eyebrow, theme = 'light' } = Astro.props;
---
<section class="page-head" data-theme="navy" data-nav-dark data-zone>
  <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="container page-head__inner">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    <div class="page-head__text">
      {eyebrow && <p class="eyebrow dot-blue">{eyebrow}</p>}
      <h1 class="display-xl page-head__title" style="view-transition-name: page-title">{title}</h1>
      {lede && <p class="body-l text-secondary measure">{lede}</p>}
    </div>
    <slot />
  </div>
</section>
<style>
  .page-head { position: relative; isolation: isolate; overflow: hidden; margin-top: calc(var(--nav-h) * -1); background: var(--navy-900); color: var(--text-primary); padding-block: calc(var(--nav-h) + clamp(36px, 5vw, 72px)) clamp(48px, 6vw, 88px); border-radius: 0 0 var(--radius-xl) var(--radius-xl); }
  .page-head__title { font-size: clamp(2.3rem, 1rem + 4.6vw, 4.75rem); letter-spacing: -0.04em; line-height: 1.02; }
  .page-head__inner { position: relative; z-index: 1; }
  .page-head__inner { display: grid; gap: var(--space-6); }
  .page-head__text { display: grid; gap: var(--space-5); }
  .page-head__title { max-width: 18em; animation: rise 800ms var(--ease-out) both; }
  .page-head__text p:last-child { animation: fade 800ms var(--ease-out) 150ms both; }
  @keyframes rise { from { opacity: 0; transform: translateY(0.4em);  } to { opacity: 1; transform: none; } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
</style>
