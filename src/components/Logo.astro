---
/** Visionqode mark — vectorised from the company's existing logo (navy V + gold swoosh). */
import { readFileSync } from 'node:fs';
interface Props { size?: number; wordmark?: boolean; class?: string }
const { size = 28, wordmark = true, class: cls = '' } = Astro.props;
const raw = readFileSync(new URL('../../public/logo-mark.svg', import.meta.url), 'utf8');
const paths = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '')
  .replace('#D4AC5C', 'var(--logo-gold, #D4AC5C)').replace('#242C54', 'var(--logo-navy, #242C54)');
---
<span class:list={['logo', cls]}>
  <svg width={size} height={Math.round(size * 0.97)} viewBox="0 0 200 194" aria-hidden="true" class="logo__mark" set:html={paths} />
  {wordmark && <span class="logo__word">Vision<span class="logo__q">qode</span></span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--text-primary); }
  .logo__mark { flex: none; }
  .logo__word { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; letter-spacing: -0.03em; line-height: 1; }
  .logo__q { color: var(--gold-800); }
  :global([data-theme='navy']) .logo__q, :global([data-theme='ink']) .logo__q { color: var(--gold-600); }
  :global([data-theme='navy']) .logo__mark, :global([data-theme='ink']) .logo__mark { --logo-navy: #ffffff; }
</style>
