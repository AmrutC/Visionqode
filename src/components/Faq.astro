---
interface Props { items: { q: string; a: string }[]; title?: string; intro?: string }
const { items, title = 'Questions buyers ask us', intro } = Astro.props;
---
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="faq__head">
      <h2 id="faq-title" class="display-l reveal">{title}</h2>
      {intro && <p class="body-m text-secondary measure-narrow reveal">{intro}</p>}
    </div>
    <div class="faq__list">
      {items.map((item) => (
        <details class="faq__item" name="faq">
          <summary class="heading-s">{item.q}<span class="faq__icon" aria-hidden="true"></span></summary>
          <p class="body-m text-secondary">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq { display: grid; gap: var(--space-6); }
  @media (min-width: 900px) { .faq { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--space-9); } }
  .faq__head { display: grid; gap: var(--space-4); align-content: start; }
  .faq__list { display: grid; gap: 10px; }
  .faq__item { border-radius: var(--radius-md); background: var(--milk-50); border: 1px solid var(--border-default); padding-inline: var(--space-5); transition: box-shadow var(--dur-base) var(--ease-out), border-color var(--dur-base); }
  .faq__item[open] { box-shadow: var(--shadow-md); border-color: rgba(22,26,51,.16); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: var(--space-5); padding-block: var(--space-4); }
  summary::-webkit-details-marker { display: none; }
  .faq__icon { position: relative; width: 34px; height: 34px; flex: none; border-radius: 50%; border: 1px solid var(--border-default); transition: background var(--dur-base), border-color var(--dur-base); }
  details[open] .faq__icon { background: var(--ink-800); border-color: var(--ink-800); }
  details[open] .faq__icon::before, details[open] .faq__icon::after { background: var(--gold-600); }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; inset: 50% auto auto 50%; background: var(--ink-800); transition: transform var(--dur-base) var(--ease-out); }
  .faq__icon::before { width: 12px; height: 1.5px; transform: translate(-50%, -50%); }
  .faq__icon::after { width: 1.5px; height: 12px; transform: translate(-50%, -50%); }
  details[open] .faq__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq__item p { padding-bottom: var(--space-4); max-width: 62ch; }
</style>
