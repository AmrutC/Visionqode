---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="crumbs label-s text-muted">
  <ol role="list">
    <li><a href="/">Home</a></li>
    {items.map((c, i) => <li aria-current={i === items.length - 1 ? 'page' : undefined}>{i === items.length - 1 ? <span>{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>)}
  </ol>
</nav>
<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .crumbs li + li::before { content: '/'; margin-right: var(--space-2); color: var(--border-default); }
  .crumbs a:hover { color: var(--text-primary); }
  .crumbs [aria-current] span { color: var(--text-secondary); }
</style>
