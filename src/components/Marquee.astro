---
interface Props { items: string[]; label: string }
const { items, label } = Astro.props;
---
<div class="marquee-wrap">
  <p class="label-s text-muted marquee-label">{label}</p>
  <div class="marquee" data-marquee>
    <ul role="list" class="marquee__track">{items.map((i, n) => <li class={`pill ${['dot-blue','dot-green','dot-red','dot-navy','dot-gold'][n % 5]}`}>{i}</li>)}</ul>
  </div>
</div>
<style>
  .marquee-wrap { padding-block: var(--space-4) var(--space-5); background: var(--bg-page); }
  .marquee-label { padding-inline: var(--gutter); max-width: var(--container-max); margin: 0 auto var(--space-3); }
  .marquee { display: flex; overflow: hidden; gap: var(--space-3); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .marquee__track { display: flex; gap: var(--space-3); flex: none; padding-inline: var(--gutter); flex-wrap: wrap; justify-content: center; width: 100%; }
  .marquee.is-animated .marquee__track { will-change: transform; flex-wrap: nowrap; width: auto; justify-content: flex-start; animation: marquee 48s linear infinite; }
  .marquee.is-animated:hover .marquee__track { animation-play-state: paused; }
  @keyframes marquee { to { transform: translateX(calc(-100% - var(--space-3))); } }
</style>
