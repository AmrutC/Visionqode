---
/**
 * Dashboard preview — the kind of operations board we build inside client ERPs.
 * Numbers are DEMO DATA (labelled on the board). Count-up + bar growth animate on scroll.
 */
import Icon from './Icon.astro';
interface Props { title?: string; compact?: boolean }
const { title = 'Operations board', compact = false } = Astro.props;
const kpis = [
  { label: 'Gate moves today', value: 1284, suffix: '', delta: '+6.2% vs yesterday', tone: 'blue', icon: 'truck' },
  { label: 'Approvals pending', value: 7, suffix: '', delta: '−12 since morning', tone: 'red', icon: 'clock' },
  { label: 'Invoices to Tally', value: 342, suffix: '', delta: '100% synced', tone: 'green', icon: 'doc' },
  { label: 'Docs auto-verified', value: 96, suffix: '%', delta: '4% to review', tone: 'gold', icon: 'shield' },
];
const bars = [38, 52, 46, 70, 64, 82, 76, 91, 85, 98, 92, 100];
---
<div class:list={['board', { 'board--compact': compact }]} data-kpi-board>
  <div class="board__head">
    <span class="board__title label-m">{title}</span>
    <span class="board__seg" aria-hidden="true"><i class="is-on">Today</i><i>Week</i><i>Month</i></span>
    <span class="board__live label-s"><span class="board__pulse" aria-hidden="true"></span>Live · demo data</span>
  </div>
  <div class="board__kpis">
    {kpis.map((k) => (
      <div class={`kpi kpi--${k.tone}`}>
        <div class="kpi__top"><span class="kpi__label">{k.label}</span><span class={`tile tile--${k.tone}`}><Icon name={k.icon as any} size={16} /></span></div>
        <span class="kpi__value" data-count={k.value} data-suffix={k.suffix}>0{k.suffix}</span>
        <span class="kpi__delta">{k.delta}</span>
      </div>
    ))}
  </div>
  <div class="board__chart" aria-hidden="true">
    <div class="board__chart-head"><span class="label-s">Throughput, last 12 weeks</span><span class="label-s board__legend"><i class="l-blue"></i>Processed <i class="l-gold"></i>Automated</span></div>
    <div class="bars">
      {bars.map((h, i) => (
        <div class="bar" style={`--h:${h}%; --i:${i}`}><span class="bar__auto" style={`--a:${Math.round(h * (0.45 + i * 0.045))}%`}></span></div>
      ))}
    </div>
  </div>
  <ul role="list" class="board__feed label-s">
    <li><span class="dot dot-green"></span>Container VQ-4821 released · invoice #10482 posted</li>
    <li><span class="dot dot-blue"></span>GST return for Client 17 verified by AI · awaiting signature</li>
    <li><span class="dot dot-red"></span>PO-233 over budget · escalated to director</li>
  </ul>
</div>

<style>
  .board { container-type: inline-size; display: grid; gap: var(--space-3); padding: var(--space-4); border-radius: 28px; background: var(--bg-surface); border: 1px solid var(--border-default); box-shadow: var(--shadow-lg), 0 60px 80px -60px rgba(5,117,230,.35); color: var(--ink-900); }
  .board__head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); }
  .board__seg { display: none; padding: 3px; border-radius: 999px; background: var(--milk-100); font-size: 11.5px; font-weight: 600; color: var(--text-muted); margin-right: auto; margin-left: 12px; }
  .board__seg i { font-style: normal; padding: 4px 10px; border-radius: 999px; }
  .board__seg .is-on { background: var(--white); color: var(--ink-900); box-shadow: var(--shadow-sm); }
  @container (min-width: 560px) { .board__seg { display: inline-flex; } }
  .board__live { display: inline-flex; align-items: center; gap: 8px; color: var(--text-muted); }
  .board__pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--green-600); box-shadow: 0 0 0 0 rgba(52, 168, 83, 0.5); animation: pulse 2s ease-out infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px rgba(52, 168, 83, 0); } 100% { box-shadow: 0 0 0 0 rgba(52, 168, 83, 0); } }
  .board__kpis { display: grid; gap: 10px; grid-template-columns: repeat(2, 1fr); }
  @container (min-width: 640px) { .board__kpis { grid-template-columns: repeat(4, 1fr); } }
  .kpi { display: grid; grid-template-rows: 32px auto auto; gap: 8px; padding: 12px 14px 12px; border-radius: 16px; background: var(--milk-50); border: 1px solid var(--border-default); transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); min-width: 0; }
  .kpi:hover { transform: translateY(-2px); box-shadow: var(--shadow-card); }
  .kpi__top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .kpi .tile { width: 30px; height: 30px; border-radius: 8px; }
  .kpi__label { font-size: 12px; font-weight: 600; color: var(--text-secondary); line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kpi__value { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.35rem, 1rem + 1vw, 1.75rem); letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .kpi__delta { font-size: 11.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kpi--blue .kpi__delta { color: var(--blue-700); } .kpi--green .kpi__delta { color: var(--green-700); } .kpi--red .kpi__delta { color: var(--red-700); } .kpi--gold .kpi__delta { color: var(--gold-800); }
  .board__chart { padding: 12px 14px; border-radius: var(--radius-md); border: 1px solid var(--border-default); background: var(--white); }
  .board__chart-head { display: flex; justify-content: space-between; color: var(--text-muted); margin-bottom: var(--space-3); flex-wrap: wrap; gap: 8px; }
  .board__legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin: 0 6px 0 10px; vertical-align: -1px; }
  .l-blue { background: var(--blue-100); } .l-gold { background: var(--gold-600); }
  .bars { display: grid; grid-template-columns: repeat(12, 1fr); gap: 6px; height: 96px; align-items: end; }
  .bar { position: relative; height: 0; border-radius: 6px 6px 3px 3px; background: var(--blue-100); overflow: hidden; transition: height 900ms var(--ease-out); transition-delay: calc(var(--i) * 45ms); }
  .is-in .bar { height: var(--h); }
  .bar__auto { position: absolute; left: 0; right: 0; bottom: 0; height: 0; background: linear-gradient(180deg, var(--gold-600), var(--gold-700)); transition: height 900ms var(--ease-out); transition-delay: calc(var(--i) * 45ms + 300ms); border-radius: 3px 3px 0 0; }
  .is-in .bar__auto { height: var(--a); }
  .board__feed { display: grid; gap: 8px; color: var(--text-secondary); }
  .board__feed li { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; background: var(--milk-100); opacity: 0; transform: translateX(-6px); transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out); }
  .is-in .board__feed li { opacity: 1; transform: none; }
  .is-in .board__feed li:nth-child(1) { transition-delay: 600ms } .is-in .board__feed li:nth-child(2) { transition-delay: 800ms } .is-in .board__feed li:nth-child(3) { transition-delay: 1000ms }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--dot); flex: none; }
  .no-js .bar { height: var(--h); } .no-js .bar__auto { height: var(--a); } .no-js .board__feed li { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .bar { height: var(--h); } .bar__auto { height: var(--a); } .board__feed li { opacity: 1; transform: none; } .board__pulse { animation: none; } }
</style>
