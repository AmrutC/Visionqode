---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import IndustryVignette from '../../components/IndustryVignette.astro';
import Cta from '../../components/Cta.astro';
import { industries } from '../../data/industries';
import { getService } from '../../data/services';
import Icon from '../../components/Icon.astro';
const industryMeta: Record<string, string> = { logistics: 'truck', 'real-estate': 'building', 'professional-services': 'scale', 'retail-ecommerce': 'cart', 'healthcare-education': 'heart', manufacturing: 'factory' };
const tones = ['blue', 'navy', 'gold'];
const crumbs = [{ name: 'Industries', href: '/industries' }];
---
<Base title="Industries — Logistics, Real Estate, CA Firms, Retail, Healthcare, Manufacturing | Visionqode" description="Visionqode builds software, automation and AI systems for logistics and container yards, real estate and construction, CA/CS practices, retail and e-commerce, healthcare, education and manufacturing." breadcrumbs={crumbs}>
  <PageHeader title="Industries we know from the inside" lede="Each of these is a kind of operation our platforms are built around. The screens are illustrative previews with demo data." crumbs={crumbs} eyebrow="Industries" />
  <section class="section section--milk">
    <div class="container inds">
      {industries.map((ind, i) => (
        <article class="ind" id={ind.slug}>
          <div class="ind__visual reveal card"><IndustryVignette slug={ind.slug} tone={tones[i % tones.length]} /></div>
          <div class="ind__copy">
            <span class={`tile tile--${tones[i % tones.length]} reveal`}><Icon name={industryMeta[ind.slug] as any} /></span>
            <h2 class="display-l reveal-clip">{ind.name}</h2>
            <p class="heading-s reveal">{ind.headline}</p>
            <p class="body-m text-secondary reveal">{ind.text}</p>
            <ul role="list" class="ind__points body-m reveal" data-stagger>{ind.points.map((p) => <li>{p}</li>)}</ul>
            <div class="ind__services reveal">
              <span class="label-s text-muted">Services involved</span>
              <ul role="list">{ind.services.map((s) => { const sv = getService(s)!; return <li><a class="link-draw label-m" href={`/services/${sv.slug}`}>{sv.name}</a></li>; })}</ul>
            </div>
            <a class="btn btn--primary ind__cta reveal" href={`/industries/${ind.slug}`}>{ind.shortName} in detail <Icon name="arrowUp" size={16} /></a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <Cta title="Your industry not listed?" text="The method is the same: map the operation, then build the system around it. Tell us what you run." />
</Base>
<style>
  .inds { display: grid; gap: clamp(64px, 8vw, 112px); }
  .ind { display: grid; gap: var(--space-6); scroll-margin-top: 100px; }
  @media (min-width: 900px) { .ind { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--space-9); align-items: center; } .ind:nth-child(even) .ind__visual { order: 2; } }
  .ind__visual { padding: var(--space-3); }
  .ind__copy { display: grid; gap: var(--space-4); }
  .ind__points { display: grid; gap: 8px; padding-left: 1.1em; list-style: disc; color: var(--text-secondary); }
  .ind__services { display: grid; gap: var(--space-2); margin-top: var(--space-3); }
  .ind__cta { justify-self: start; margin-top: var(--space-2); }
  .ind__services ul { display: flex; flex-wrap: wrap; gap: var(--space-4); }
</style>
