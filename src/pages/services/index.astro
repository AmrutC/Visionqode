---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Cta from '../../components/Cta.astro';
import { services } from '../../data/services';
import { site } from '../../data/site';
import Icon from '../../components/Icon.astro';
const meta: Record<string, { icon: string; tone: string }> = { 'ai-automation': { icon: 'brain', tone: 'blue' }, 'custom-software-erp': { icon: 'layers', tone: 'navy' }, 'web-mobile-apps': { icon: 'device', tone: 'gold' }, 'website-design': { icon: 'globe', tone: 'blue' }, 'process-automation': { icon: 'workflow', tone: 'navy' }, 'api-integration': { icon: 'plug', tone: 'gold' } };
const crumbs = [{ name: 'Services', href: '/services' }];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Visionqode services',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${site.url}/services/${s.slug}` })),
};
---
<Base title="Services — AI, Software, ERP, Apps, Websites & Automation | Visionqode" description="Six disciplines under one roof: AI and intelligent automation, custom software and ERP, web and mobile applications, website design, business process automation, and API integration with UI/UX." breadcrumbs={crumbs} jsonLd={[ld]}>
  <PageHeader title="Six disciplines. One team that has built the whole system before." lede="Most engagements use three or four of these together — an ERP with WhatsApp automation and a Tally integration, say. Start with the one that matches the problem; we will tell you what else it needs." crumbs={crumbs} eyebrow="Services" />
  <section class="section section--milk">
    <div class="container">
      <div class="services reveal" data-stagger>
        {services.map((s, i) => (
          <a class="card service" href={`/services/${s.slug}`}>
            <span class={`tile tile--${meta[s.slug].tone}`}><Icon name={meta[s.slug].icon as any} /></span>
            <h2 class="heading-m">{s.name}</h2>
            <p class="body-m text-secondary">{s.short}</p>
            <ul role="list" class="service__tags label-s text-muted">{s.deliverables.slice(0, 3).map((d) => <li>{d.title}</li>)}</ul>
            <span class="service__go label-m text-accent">Read about {s.name.toLowerCase()} <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Cta title="Not sure which one you need?" text="Describe the problem in a sentence. We will map it to the right mix and come back with a plan." />
</Base>
<style>
  .services { display: grid; gap: var(--space-5); }
  @media (min-width: 760px) { .services { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .services { grid-template-columns: repeat(3, 1fr); } }
  .service__go { display: inline-flex; align-items: center; gap: 6px; }
  .service__tags { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: var(--space-2); }
  .service__go { margin-top: var(--space-3); }
</style>
