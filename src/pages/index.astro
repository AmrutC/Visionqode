---
import Base from '../layouts/Base.astro';
import Schematic from '../components/Schematic.astro';
import Marquee from '../components/Marquee.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { site, platforms, stack, process, homeFaqs } from '../data/site';
import { services } from '../data/services';
import { industries } from '../data/industries';

const title = 'Visionqode — Software, Automation & AI Systems Engineered in Navi Mumbai';
const description = 'Visionqode designs and engineers ERPs, business automation, AI systems, websites and mobile apps for growing companies across India. Where vision meets code.';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const solutions = [
  { problem: 'The business runs on spreadsheets, Tally and WhatsApp', solution: 'Business management platforms', href: '/services/custom-software-erp' },
  { problem: 'Staff re-type documents into systems all day', solution: 'Document intelligence and AI agents', href: '/services/ai-automation' },
  { problem: 'Approvals and follow-ups depend on someone remembering', solution: 'Workflow and WhatsApp automation', href: '/services/process-automation' },
  { problem: 'Customers call to ask for a status you already have', solution: 'Customer-facing apps and portals', href: '/services/web-mobile-apps' },
  { problem: 'Three systems hold three versions of the truth', solution: 'Integrations and intelligent dashboards', href: '/services/api-integration' },
  { problem: 'The website looks fine but never produces an enquiry', solution: 'Search-ready, conversion-led websites', href: '/services/website-design' },
];
const why = [
  { title: 'Business first, then code', text: 'Every engagement starts by mapping how the business actually runs. Software follows the process — not the other way round.' },
  { title: 'Design and engineering in one room', text: 'The people who draw the screens sit with the people who write the data model, so what gets designed gets built.' },
  { title: 'AI where it earns its place', text: 'Language models and OCR go where they remove hours of work and are measured against a human baseline — not sprinkled on for the pitch.' },
  { title: 'Integration is the product', text: 'Tally, SAP, Zoho, Razorpay, WhatsApp — systems that talk to each other are what make a dashboard trustworthy.' },
  { title: 'Fixed proposals, short cycles', text: 'Scope, milestones and cost agreed up front; working software every two weeks so direction changes early, not late.' },
  { title: 'A partner after launch', text: 'A support window with SLAs, then a retainer for whatever the business asks for next. The code and data are yours throughout.' },
];
---
<Base {title} {description} jsonLd={[faqLd]}>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 class="display-hero hero__title">
          <span class="hero__line">Software that runs</span>
          <span class="hero__line">the business, not</span>
          <span class="hero__line">just the website.</span>
        </h1>
        <p class="body-l text-secondary measure-narrow hero__lede">Visionqode designs and engineers ERPs, automation and AI systems for companies in {site.address.locality} and across India — from the first enquiry to the last ledger entry.</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contact">Start a project</a>
          <a class="btn btn--secondary" href="#process">See how a project runs</a>
        </div>
      </div>
      <div class="hero__visual">
        <Schematic />
      </div>
    </div>
    <div class="container hero__facts">
      <dl>
        <div><dt class="label-s text-muted">Based in</dt><dd class="label-m">{site.address.locality}, {site.address.region}</dd></div>
        <div><dt class="label-s text-muted">Working with</dt><dd class="label-m">Clients across India and abroad</dd></div>
        <div><dt class="label-s text-muted">Led by</dt><dd class="label-m">{site.founder.name}, {site.founder.role}</dd></div>
        <div><dt class="label-s text-muted">Reply time</dt><dd class="label-m">Within one business day</dd></div>
      </dl>
    </div>
  </section>

  <Marquee label="Platforms we build on and integrate with" items={platforms} />

  <!-- INTRO -->
  <section class="section section--surface" aria-labelledby="intro-title">
    <div class="container intro">
      <h2 id="intro-title" class="heading-s text-muted">What we do</h2>
      <p class="display-l reveal-clip">Most companies run on a dozen disconnected tools and a lot of WhatsApp. We replace that with one system — built around how the business actually operates — and then make it intelligent: documents read themselves, approvals move without chasing, and the numbers are right when the director opens the dashboard.</p>
      <div class="intro__who reveal">
        <p class="body-m text-secondary">We work with founders, business owners and technology leaders at growing companies and enterprises — in logistics, real estate, professional services, retail, healthcare, education and manufacturing.</p>
        <a class="btn btn--link" href="/about">About Visionqode <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13 13 3M5 3h8v8"/></svg></a>
      </div>
    </div>
  </section>

  <!-- SERVICES LEDGER -->
  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head section-head--split">
        <h2 id="services-title" class="display-xl reveal-clip">Six disciplines, one team</h2>
        <a class="btn btn--link reveal" href="/services">All services <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13 13 3M5 3h8v8"/></svg></a>
      </div>
      <div class="ledger reveal" data-stagger>
        {services.map((s) => (
          <a class="ledger__row" href={`/services/${s.slug}`}>
            <h3 class="heading-m">{s.name}</h3>
            <p class="body-m text-secondary">{s.short}</p>
            <svg class="ledger__arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 19 19 5M8 5h11v11"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SOLUTIONS: problem → solution -->
  <section class="section section--surface" id="solutions" aria-labelledby="solutions-title">
    <div class="container">
      <div class="section-head">
        <h2 id="solutions-title" class="display-xl reveal-clip">Start from the problem</h2>
        <p class="body-l text-secondary measure-narrow reveal">You do not need to know what to call the solution. Find the sentence that sounds like your company.</p>
      </div>
      <ol role="list" class="solutions reveal" data-stagger>
        {solutions.map((s) => (
          <li class="solutions__item">
            <p class="heading-s">“{s.problem}.”</p>
            <a href={s.href} class="solutions__answer label-m">{s.solution}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WHY -->
  <section class="section" aria-labelledby="why-title">
    <div class="container why">
      <div class="why__head">
        <h2 id="why-title" class="display-xl reveal-clip">How we work differently</h2>
        <p class="body-l text-secondary measure-narrow reveal">Not claims — the way every project here is actually run.</p>
      </div>
      <dl class="why__list reveal" data-stagger>
        {why.map((w) => (
          <div class="why__item"><dt class="heading-s">{w.title}</dt><dd class="body-m text-secondary">{w.text}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section section--surface" id="industries" aria-labelledby="industries-title">
    <div class="container">
      <div class="section-head section-head--split">
        <h2 id="industries-title" class="display-xl reveal-clip">Industries we know from the inside</h2>
        <a class="btn btn--link reveal" href="/industries">All industries <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13 13 3M5 3h8v8"/></svg></a>
      </div>
      <div class="industries reveal" data-stagger>
        {industries.slice(0, 4).map((ind) => (
          <article class="industry">
            <div class="industry__visual" aria-hidden="true">
              <Schematic compact nodes={ind.schematic.nodes} status={ind.schematic.status} caption="" />
            </div>
            <div class="industry__copy">
              <h3 class="heading-m">{ind.name}</h3>
              <p class="body-m text-secondary">{ind.headline}</p>
              <ul role="list" class="industry__points body-s text-secondary">{ind.points.map((p) => <li>{p}</li>)}</ul>
              <a class="btn btn--link label-m" href={`/industries#${ind.slug}`}>{ind.shortName} in detail</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section" id="process" data-theme="ink" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head section-head--split">
        <h2 id="process-title" class="display-xl reveal-clip">How a project runs</h2>
        <p class="body-m text-secondary measure-narrow reveal">Six stages, each with an owner, a deliverable and a check before the next one starts.</p>
      </div>
      <ol role="list" class="process reveal" data-stagger>
        {process.map((p) => (
          <li class="process__step">
            <span class="mono text-accent">{p.n}</span>
            <h3 class="heading-s">{p.title}</h3>
            <p class="body-s text-secondary">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WORK FRAMEWORK -->
  <section class="section section--surface" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head section-head--split">
        <h2 id="work-title" class="display-xl reveal-clip">Selected work</h2>
        <a class="btn btn--link reveal" href="/work">Case studies <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 13 13 3M5 3h8v8"/></svg></a>
      </div>
      <div class="work reveal" data-stagger>
        {industries.slice(0, 3).map((ind) => (
          <article class="work__item needs-approval">
            <p class="label-s text-muted">{ind.name}</p>
            <h3 class="heading-m">{ind.headline}</h3>
            <p class="body-s text-secondary">{ind.text}</p>
            <p class="mono text-muted work__note">Client name, screenshots and verified outcomes to be approved before publishing.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- STACK -->
  <section class="section section--tight" aria-labelledby="stack-title">
    <div class="container stack">
      <h2 id="stack-title" class="heading-s text-muted">Built with</h2>
      <ul role="list" class="stack__list label-m text-secondary">{stack.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <Faq items={homeFaqs} intro="Short, honest answers to the questions we hear in first conversations." />
  <Cta />
</Base>

<style>
  /* hero */
  .hero { padding-block: clamp(56px, 8vw, 112px) clamp(40px, 5vw, 64px); background: var(--bg-page); }
  .hero__grid { display: grid; gap: var(--space-8); align-items: center; }
  @media (min-width: 1000px) { .hero__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-9); } }
  .hero__title { display: grid; text-wrap: initial; font-size: clamp(2.6rem, 1rem + 4.4vw, 4.5rem); }
  .hero__line { display: block; }
  @media (min-width: 1000px) { .hero__line { white-space: nowrap; } }
  .hero__line { animation: rise 900ms var(--ease-out) both; }
  .hero__line:nth-child(2) { animation-delay: 90ms } .hero__line:nth-child(3) { animation-delay: 180ms }
  .hero__lede { margin-top: var(--space-6); animation: fade 800ms var(--ease-out) 360ms both; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-6); animation: fade 800ms var(--ease-out) 480ms both; }
  .hero__visual { animation: fade 1000ms var(--ease-out) 200ms both; }
  @keyframes rise { from { opacity: 0; transform: translateY(0.6em); } to { opacity: 1; transform: none; } }
  @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .hero__facts { margin-top: clamp(40px, 6vw, 80px); }
  .hero__facts dl { display: grid; gap: var(--space-5); grid-template-columns: repeat(2, 1fr); padding-top: var(--space-5); border-top: 1px solid var(--border-default); }
  @media (min-width: 900px) { .hero__facts dl { grid-template-columns: repeat(4, 1fr); } }
  .hero__facts dd { margin: 4px 0 0; }

  /* intro */
  .intro { display: grid; gap: var(--space-5); }
  @media (min-width: 900px) { .intro { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--space-9); } .intro__who { grid-column: 2; } }
  .intro .display-l { max-width: 24em; }
  .intro__who { display: grid; gap: var(--space-4); max-width: 62ch; justify-items: start; }

  /* solutions */
  .solutions { display: grid; gap: var(--space-4); }
  @media (min-width: 760px) { .solutions { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .solutions { grid-template-columns: 1fr 1fr 1fr; } }
  .solutions__item { display: grid; gap: var(--space-4); align-content: space-between; padding: var(--space-6); border: 1px solid var(--border-default); border-radius: var(--radius-md); background: var(--bg-page); min-height: 200px; }
  .solutions__item .heading-s { font-weight: 500; font-style: italic; }
  .solutions__answer { display: inline-flex; align-items: center; gap: 8px; color: var(--text-accent); }
  .solutions__answer svg { transition: transform var(--dur-fast) var(--ease-out); }
  .solutions__answer:hover svg { transform: translateX(3px); }

  /* why */
  .why { display: grid; gap: var(--space-7); }
  @media (min-width: 900px) { .why { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-9); } }
  .why__head { display: grid; gap: var(--space-4); align-content: start; position: sticky; top: 100px; }
  .why__list { display: grid; gap: 0; margin: 0; }
  .why__item { display: grid; gap: var(--space-2); padding-block: var(--space-5); border-top: 1px solid var(--border-default); }
  @media (min-width: 640px) { .why__item { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--space-6); } }
  .why__item dd { margin: 0; }

  /* industries */
  .industries { display: grid; gap: var(--space-6); }
  @media (min-width: 900px) { .industries { grid-template-columns: 1fr 1fr; } }
  .industry { display: grid; gap: var(--space-5); padding: var(--space-6); border: 1px solid var(--border-default); border-radius: var(--radius-md); background: var(--bg-page); }
  @media (min-width: 640px) { .industry { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: center; } }
  .industry__visual { padding: var(--space-3); border-radius: var(--radius-sm); background: var(--bg-surface); }
  .industry__visual :global(figcaption) { display: none; }
  .industry__copy { display: grid; gap: var(--space-3); justify-items: start; }
  .industry__points { display: grid; gap: 6px; padding-left: 1.1em; list-style: disc; }

  /* process */
  .process { display: grid; gap: var(--space-6); }
  @media (min-width: 640px) { .process { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .process { grid-template-columns: repeat(6, 1fr); gap: var(--space-5); } }
  .process__step { display: grid; gap: var(--space-3); padding-top: var(--space-5); border-top: 1.5px solid var(--border-default); align-content: start; }
  .process__step .mono { font-size: var(--label-m); }

  /* work */
  .work { display: grid; gap: var(--space-5); }
  @media (min-width: 900px) { .work { grid-template-columns: repeat(3, 1fr); } }
  .work__item { display: grid; gap: var(--space-3); padding: var(--space-6); border-radius: var(--radius-md); background: var(--bg-page); border: 1px solid var(--border-default); align-content: start; }
  .work__note { margin-top: var(--space-3); }

  /* stack */
  .stack { display: grid; gap: var(--space-4); }
  @media (min-width: 900px) { .stack { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--space-9); } }
  .stack__list { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
</style>
