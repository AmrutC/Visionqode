---
import Base from '../layouts/Base.astro';
import IndustryVignette from '../components/IndustryVignette.astro';
import KpiBoard from '../components/KpiBoard.astro';
import Marquee from '../components/Marquee.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import { site, platforms, stack, process, homeFaqs } from '../data/site';
import { services } from '../data/services';
import { industries } from '../data/industries';

const title = 'Visionqode — Software, Automation & AI Systems Engineered in Navi Mumbai';
const description = 'Visionqode designs and engineers ERPs, business automation, AI systems, websites and mobile apps for growing companies across India. Where vision meets code.';
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: homeFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const serviceMeta: Record<string, { icon: string; tone: string }> = {
  'ai-automation': { icon: 'brain', tone: 'blue' },
  'custom-software-erp': { icon: 'layers', tone: 'navy' },
  'web-mobile-apps': { icon: 'device', tone: 'gold' },
  'website-design': { icon: 'globe', tone: 'blue' },
  'process-automation': { icon: 'workflow', tone: 'navy' },
  'api-integration': { icon: 'plug', tone: 'gold' },
};
const industryMeta: Record<string, string> = { logistics: 'truck', 'real-estate': 'building', 'professional-services': 'scale', 'retail-ecommerce': 'cart', 'healthcare-education': 'heart', manufacturing: 'factory' };
const tones = ['blue', 'navy', 'gold'];

const solutions = [
  { problem: 'The business runs on spreadsheets, Tally and WhatsApp', solution: 'Business management platforms', href: '/services/custom-software-erp', icon: 'layers' },
  { problem: 'Staff re-type documents into systems all day', solution: 'Document intelligence and AI agents', href: '/services/ai-automation', icon: 'doc' },
  { problem: 'Approvals and follow-ups depend on someone remembering', solution: 'Workflow and WhatsApp automation', href: '/services/process-automation', icon: 'bolt' },
  { problem: 'Customers call to ask for a status you already have', solution: 'Customer-facing apps and portals', href: '/services/web-mobile-apps', icon: 'device' },
  { problem: 'Three systems hold three versions of the truth', solution: 'Integrations and intelligent dashboards', href: '/services/api-integration', icon: 'chart' },
  { problem: 'The website looks fine but never produces an enquiry', solution: 'Search-ready, conversion-led websites', href: '/services/website-design', icon: 'globe' },
];
const why = [
  { title: 'Business first, then code', text: 'Every engagement starts by mapping how the business actually runs. Software follows the process — not the other way round.', icon: 'workflow' },
  { title: 'Design and engineering in one room', text: 'The people who draw the screens sit with the people who write the data model, so what gets designed gets built.', icon: 'users' },
  { title: 'AI where it earns its place', text: 'Language models and OCR go where they remove hours of work and are measured against a human baseline.', icon: 'brain' },
  { title: 'Integration is the product', text: 'Tally, SAP, Zoho, Razorpay, WhatsApp — systems that talk to each other are what make a dashboard trustworthy.', icon: 'plug' },
  { title: 'Fixed proposals, short cycles', text: 'Scope, milestones and cost agreed up front; working software every two weeks so direction changes early, not late.', icon: 'clock' },
  { title: 'A partner after launch', text: 'A support window with SLAs, then a retainer for whatever the business asks for next. The code and data are yours.', icon: 'shield' },
];
---
<Base {title} {description} jsonLd={[faqLd]}>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__sky" aria-hidden="true">
      <span class="hero__grid-bg"></span>
      <span class="blob blob--blue" data-parallax="0.12"></span>
      <span class="blob blob--gold" data-parallax="0.2"></span>
    </div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__badge"><span class="hero__badge-dot"></span>Software, automation & AI · Navi Mumbai</p>
        <h1 class="display-hero hero__title">
          <span class="hero__line">Software that <span class="hero__underline">runs</span></span>
          <span class="hero__line">the <span class="grad grad--blue">business</span>,</span>
          <span class="hero__line">not just</span>
          <span class="hero__line">the website.</span>
        </h1>
        <p class="body-l text-secondary measure-narrow hero__lede">Visionqode designs and engineers ERPs, automation and intelligent systems for companies in {site.address.locality} and across India — from the first enquiry to the last ledger entry.</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contact" data-magnetic>Start a project <Icon name="arrowUp" size={16} /></a>
          <a class="btn btn--secondary" href="#process">See how a project runs</a>
        </div>
        <dl class="hero__facts">
          <div><dt class="label-s text-muted">Based in</dt><dd class="label-m">{site.address.locality}, {site.address.region}</dd></div>
          <div><dt class="label-s text-muted">Led by</dt><dd class="label-m">{site.founder.name}</dd></div>
          <div><dt class="label-s text-muted">Reply time</dt><dd class="label-m">One business day</dd></div>
        </dl>
      </div>
      <div class="hero__visual" data-tilt>
        <div class="hero__board" data-tilt-target><KpiBoard title="Yard & finance board" /></div>
        <div class="hero__float hero__float--a" aria-hidden="true"><span class="tile tile--green"><Icon name="check" size={18} /></span><span><strong class="label-m">Invoice posted to Tally</strong><br /><span class="label-s text-muted">2 seconds ago · no manual touch</span></span></div>
        <div class="hero__float hero__float--b" aria-hidden="true"><span class="tile tile--blue"><Icon name="whatsapp" size={18} /></span><span><strong class="label-m">Lead qualified on WhatsApp</strong><br /><span class="label-s text-muted">Site visit booked for Saturday</span></span></div>
      </div>
    </div>
  </section>

  <Marquee label="Platforms we build on and integrate with" items={platforms} />

  <!-- INTRO -->
  <section class="section section--milk" aria-labelledby="intro-title">
    <div class="container intro">
      <h2 id="intro-title" class="eyebrow dot-blue">What we do</h2>
      <p class="display-l reveal-clip">Most companies run on a dozen disconnected tools and a lot of WhatsApp. We replace that with <span class="grad grad--blue">one system</span> — built around how the business actually operates — and then make it intelligent: documents read themselves, approvals move without chasing, and the numbers are right when the director opens the dashboard.</p>
      <div class="intro__who reveal">
        <p class="body-m text-secondary">We work with founders, business owners and technology leaders at growing companies and enterprises — in logistics, real estate, professional services, retail, healthcare, education and manufacturing.</p>
        <a class="btn btn--link" href="/about">About Visionqode <Icon name="arrowUp" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div><p class="eyebrow dot-blue">Services</p><h2 id="services-title" class="display-xl reveal-clip">Six disciplines, one team</h2></div>
        <a class="btn btn--link reveal" href="/services">All services <Icon name="arrowUp" size={16} /></a>
      </div>
      <div class="ledger reveal" data-stagger>
        {services.map((s) => { const m = serviceMeta[s.slug]; return (
          <a class={`ledger__row dot-${m.tone}`} href={`/services/${s.slug}`}>
            <span class={`tile tile--${m.tone}`}><Icon name={m.icon as any} /></span>
            <h3 class="heading-m">{s.name}</h3>
            <p class="body-m text-secondary">{s.short}</p>
            <Icon name="arrowUp" class="ledger__arrow" size={22} />
          </a>
        ); })}
      </div>
    </div>
  </section>

  <!-- SOLUTIONS -->
  <section class="section section--milk" id="solutions" aria-labelledby="solutions-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow dot-gold">Solutions</p>
        <h2 id="solutions-title" class="display-xl reveal-clip">Start from the problem</h2>
        <p class="body-l text-secondary measure-narrow reveal">You do not need to know what to call the solution. Find the sentence that sounds like your company.</p>
      </div>
      <ol role="list" class="solutions reveal" data-stagger>
        {solutions.map((s, i) => (
          <li class="card solutions__item">
            <span class={`tile tile--${tones[i % tones.length]}`}><Icon name={s.icon as any} /></span>
            <p class="heading-s solutions__problem">“{s.problem}.”</p>
            <a href={s.href} class="solutions__answer label-m">{s.solution} <Icon name="arrow" size={16} /></a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WHY -->
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div><p class="eyebrow dot-navy">Why Visionqode</p><h2 id="why-title" class="display-xl reveal-clip">How we work differently</h2></div>
        <p class="body-m text-secondary measure-narrow reveal">Not claims — the way every project here is actually run.</p>
      </div>
      <div class="bento reveal" data-stagger>
        {why.map((w, i) => (
          <article class:list={['card', 'bento__card', { 'bento__card--wide': [0, 3, 5].includes(i), 'bento__card--navy': i === 0 }]} data-theme={i === 0 ? 'navy' : undefined}>
            <span class={`tile tile--${i === 0 ? 'gold' : tones[i % tones.length]}`}><Icon name={w.icon as any} /></span>
            <h3 class="heading-m">{w.title}</h3>
            <p class="body-m text-secondary">{w.text}</p>
            <span class="bento__ghost" aria-hidden="true"><Icon name={w.icon as any} size={160} /></span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section section--milk" id="industries" aria-labelledby="industries-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div><p class="eyebrow dot-gold">Industries</p><h2 id="industries-title" class="display-xl reveal-clip">Industries we know from the inside</h2></div>
        <a class="btn btn--link reveal" href="/industries">All industries <Icon name="arrowUp" size={16} /></a>
      </div>
      <div class="industries reveal" data-stagger>
        {industries.slice(0, 4).map((ind, i) => (
          <article class="card industry">
            <IndustryVignette slug={ind.slug} tone={tones[i % tones.length]} />
            <div class="industry__copy">
              <span class={`tile tile--${tones[i % tones.length]}`}><Icon name={industryMeta[ind.slug] as any} /></span>
              <h3 class="heading-m">{ind.name}</h3>
              <p class="body-m text-secondary">{ind.headline}</p>
              <ul role="list" class="industry__points body-s text-secondary">{ind.points.map((p) => <li><Icon name="check" size={14} />{p}</li>)}</ul>
              <a class="btn btn--link label-m" href={`/industries#${ind.slug}`}>{ind.shortName} in detail <Icon name="arrow" size={16} /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS (navy band) -->
  <section class="section band process-band" id="process" data-theme="navy" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div><p class="eyebrow" style="--dot: var(--gold-600)">Process</p><h2 id="process-title" class="display-xl reveal-clip">How a project runs</h2></div>
        <p class="body-m text-secondary measure-narrow reveal">Six stages, each with an owner, a deliverable and a check before the next one starts.</p>
      </div>
      <ol role="list" class="timeline" data-process>
        {process.map((p) => (
          <li class="timeline__step">
            <span class="timeline__num">{p.n}</span>
            <h3 class="heading-s">{p.title}</h3>
            <p class="body-s text-secondary">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WORK -->
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div><p class="eyebrow dot-blue">Work</p><h2 id="work-title" class="display-xl reveal-clip">Selected work</h2></div>
        <a class="btn btn--link reveal" href="/work">Case studies <Icon name="arrowUp" size={16} /></a>
      </div>
      <div class="work reveal" data-stagger>
        {industries.slice(0, 3).map((ind, i) => (
          <article class="card card--milk work__item needs-approval">
            <span class={`tile tile--${tones[i % tones.length]}`}><Icon name={industryMeta[ind.slug] as any} /></span>
            <p class="label-s text-muted">{ind.name}</p>
            <h3 class="heading-m">{ind.headline}</h3>
            <p class="body-s text-secondary">{ind.text}</p>
            <p class="mono text-muted work__note">Client name, screenshots and verified outcomes to be approved before publishing.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- STACK -->
  <section class="section section--tight section--milk" aria-labelledby="stack-title">
    <div class="container stack">
      <h2 id="stack-title" class="eyebrow dot-navy">Built with</h2>
      <ul role="list" class="stack__list">{stack.map((s, i) => <li class={`pill ${['dot-blue','dot-navy','dot-gold'][i % 3]}`}>{s}</li>)}</ul>
    </div>
  </section>

  <Faq items={homeFaqs} intro="Short, honest answers to the questions we hear in first conversations." />
  <Cta />
</Base>

<style>
  /* hero */
  .hero { position: relative; overflow: hidden; margin-top: calc(var(--nav-h) * -1); padding-block: calc(var(--nav-h) + clamp(28px, 4vw, 56px)) clamp(48px, 5vw, 72px); background: var(--white); }
  .hero__sky { position: absolute; inset: 0; pointer-events: none; }
  .hero__grid-bg { position: absolute; inset: 0; background-image: radial-gradient(rgba(22, 26, 51, 0.13) 1px, transparent 1px); background-size: 22px 22px; mask-image: radial-gradient(70% 70% at 70% 30%, #000 0%, transparent 75%); -webkit-mask-image: radial-gradient(70% 70% at 70% 30%, #000 0%, transparent 75%); }
  .blob { position: absolute; border-radius: 50%; filter: blur(70px); will-change: transform; }
  .blob--blue { width: 50vw; height: 50vw; max-width: 680px; max-height: 680px; right: -14vw; top: -18vw; background: radial-gradient(closest-side, rgba(92,178,255,.5), transparent); animation: drift 16s ease-in-out infinite; }
  .blob--gold { width: 30vw; height: 30vw; max-width: 420px; max-height: 420px; left: -12vw; bottom: -14vw; background: radial-gradient(closest-side, rgba(212,172,92,.38), transparent); animation: drift 20s ease-in-out infinite reverse; }
  .hero__grid { position: relative; display: grid; gap: var(--space-8); align-items: center; }
  @media (min-width: 1000px) { .hero__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-8); } }
  .hero__badge { display: inline-flex; align-items: center; gap: 10px; padding: 7px 14px 7px 10px; border-radius: var(--radius-pill); background: var(--white); border: 1px solid var(--border-default); box-shadow: var(--shadow-sm); font-size: var(--label-s); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-5); animation: fade 800ms var(--ease-out) both; }
  .hero__badge-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold-600); box-shadow: 0 0 0 4px rgba(212,172,92,.25); }
  .hero__title { display: grid; text-wrap: initial; font-size: clamp(2.5rem, 0.9rem + 3.7vw, 3.85rem); font-weight: 800; letter-spacing: -0.045em; line-height: 1.02; }
  .hero__line { display: block; animation: rise 1000ms var(--ease-out) both; }
  .hero__line:nth-child(2) { animation-delay: 90ms } .hero__line:nth-child(3) { animation-delay: 180ms } .hero__line:nth-child(4) { animation-delay: 270ms }
  @media (min-width: 1000px) { .hero__line { white-space: nowrap; } }
  .hero__underline { position: relative; display: inline-block; }
  .hero__underline::after { content: ''; position: absolute; left: -2%; right: -2%; bottom: 0.02em; height: 0.16em; background: var(--gold-600); border-radius: 999px; transform: skewX(-12deg) scaleX(0); transform-origin: left; animation: draw 800ms var(--ease-out) 800ms both; z-index: -1; }
  @keyframes draw { to { transform: skewX(-12deg) scaleX(1); } }
  .hero__lede { margin-top: var(--space-5); animation: fade 800ms var(--ease-out) 360ms both; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); animation: fade 800ms var(--ease-out) 480ms both; }
  .hero__facts { display: flex; flex-wrap: wrap; gap: var(--space-6); margin-top: var(--space-7); padding-top: var(--space-4); border-top: 1px solid var(--border-default); animation: fade 800ms var(--ease-out) 600ms both; }
  .hero__facts dd { margin-top: 2px; }
  .hero__visual { position: relative; animation: fade 1100ms var(--ease-out) 300ms both; }
  .hero__board { transition: transform 500ms var(--ease-out); transform-style: preserve-3d; will-change: transform; }
  .hero__float { position: absolute; display: flex; gap: 12px; align-items: center; padding: 12px 16px 12px 12px; border-radius: 16px; background: color-mix(in srgb, var(--white) 88%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid var(--border-default); box-shadow: var(--shadow-lg); animation: float 7s ease-in-out infinite; }
  .hero__float--a { left: -28px; bottom: -40px; animation-delay: .5s; }
  .hero__float--b { right: -20px; top: -50px; animation-delay: 2s; }
  @media (min-width: 1000px) { .hero__visual { margin-top: 40px; } }
  @media (max-width: 1100px) { .hero__float { display: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(0.5em); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes fade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  /* intro */
  .intro { display: grid; gap: var(--space-4); align-items: start; }
  .intro > .eyebrow { align-self: start; }
  @media (min-width: 900px) { .intro { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); column-gap: var(--space-9); row-gap: var(--space-5); } .intro__who { grid-column: 2; } }
  .intro .display-l { max-width: 24em; }
  .intro__who { display: grid; gap: var(--space-3); max-width: 62ch; justify-items: start; margin-top: var(--space-2); }

  /* solutions */
  .solutions { display: grid; gap: var(--space-4); }
  @media (min-width: 760px) { .solutions { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .solutions { grid-template-columns: 1fr 1fr 1fr; } }
  .solutions__item { min-height: 0; align-content: start; }
  .solutions__problem { font-weight: 600; font-style: italic; color: var(--text-primary); margin-top: var(--space-2); }
  .solutions__answer { display: inline-flex; align-items: center; gap: 8px; color: var(--text-accent); margin-top: auto; }
  .solutions__answer svg { transition: transform var(--dur-fast) var(--ease-out); }
  .solutions__answer:hover svg { transform: translateX(3px); }

  /* why — bento */
  .bento { display: grid; gap: var(--space-4); }
  @media (min-width: 760px) { .bento { grid-template-columns: repeat(3, 1fr); } .bento__card--wide { grid-column: span 2; } }
  .bento__card { overflow: hidden; padding: var(--space-6); min-height: 210px; gap: var(--space-3); }
  .bento__card .body-m { max-width: 46ch; }
  .bento__card--navy { background: var(--grad-navy); border-color: transparent; color: var(--text-primary); }
  .bento__ghost { position: absolute; right: -28px; bottom: -36px; z-index: -1; color: var(--text-primary); opacity: .045; transform: rotate(-12deg); transition: transform var(--dur-slow) var(--ease-out), opacity var(--dur-slow); }
  .bento__ghost :global(svg) { stroke-width: 1; }
  .bento__card:hover .bento__ghost { transform: rotate(-4deg) scale(1.06); opacity: .08; }

  /* industries */
  .industries { display: grid; gap: var(--space-4); }
  @media (min-width: 900px) { .industries { grid-template-columns: 1fr 1fr; } }
  .industry { gap: var(--space-5); padding: var(--space-3) var(--space-3) var(--space-6); }
  .industry__copy { padding-inline: var(--space-3); }
  .industry__copy { display: grid; gap: var(--space-3); justify-items: start; }
  .industry__points { display: grid; gap: 6px; }
  .industry__points li { display: flex; gap: 8px; align-items: flex-start; }
  .industry__points svg { color: var(--blue-600); flex: none; margin-top: 4px; stroke-width: 2.75; }

  /* process — scroll-linked timeline */
  .process-band { padding-block: clamp(56px, 7vw, 96px); }
  .timeline { --p: 0; position: relative; display: grid; gap: var(--space-6); padding-left: 56px; }
  .timeline::before, .timeline::after { content: ''; position: absolute; left: 19px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: rgba(255,255,255,.14); }
  .timeline::after { background: linear-gradient(180deg, var(--gold-600), #f0d9a6); transform: scaleY(var(--p)); transform-origin: top; }
  .timeline__step { position: relative; z-index: 1; display: grid; gap: var(--space-2); align-content: start; opacity: .5; transition: opacity var(--dur-slow) var(--ease-out); }
  .timeline__step.is-active { opacity: 1; }
  .timeline__num { position: absolute; left: -56px; top: -4px; z-index: 1; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--navy-600); border: 2px solid rgba(255,255,255,.22); color: rgba(255,255,255,.7); font-family: var(--font-display); font-weight: 700; font-size: .85rem; transition: background var(--dur-base) var(--ease-out), border-color var(--dur-base), color var(--dur-base), transform var(--dur-base) var(--ease-spring), box-shadow var(--dur-base); }
  .is-active .timeline__num { background: var(--gold-600); border-color: var(--gold-600); color: var(--ink-900); transform: scale(1.08); box-shadow: 0 0 0 6px rgba(212,172,92,.18); }
  @media (min-width: 1000px) {
    .timeline { grid-template-columns: repeat(6, 1fr); gap: var(--space-5); padding-left: 0; padding-top: 64px; }
    .timeline::before, .timeline::after { left: 20px; right: 20px; top: 19px; bottom: auto; width: auto; height: 2px; }
    .timeline::after { background: linear-gradient(90deg, var(--gold-600), #f0d9a6); transform: scaleX(var(--p)); transform-origin: left; }
    .timeline__num { left: 0; top: -64px; }
  }

  /* work */
  .work { display: grid; gap: var(--space-4); }
  @media (min-width: 900px) { .work { grid-template-columns: repeat(3, 1fr); } }
  .work__note { margin-top: var(--space-3); }

  /* stack */
  .stack { display: grid; gap: var(--space-4); }
  @media (min-width: 900px) { .stack { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--space-9); } }
  .stack__list { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
</style>
