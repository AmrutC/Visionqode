---
import Base from '../layouts/Base.astro';
import IndustryVignette from '../components/IndustryVignette.astro';
import KpiBoard from '../components/KpiBoard.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import { site, platforms, process, homeFaqs } from '../data/site';
import { services } from '../data/services';
import { industries } from '../data/industries';

const title = 'Visionqode — Software, Automation & AI Systems Engineered in Navi Mumbai';
const description = 'Visionqode builds the ERP, automation and AI systems that replace spreadsheets, Tally re-entry and WhatsApp follow-ups for growing Indian businesses.';
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: homeFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const rotating = ['the business.', 'the yard.', 'the site office.', 'the practice.', 'the shop floor.'];
const band1 = ['ERP', 'Automation', 'AI systems', 'Mobile apps', 'Websites', 'Integrations'];
const band2 = ['Tally', 'WhatsApp', 'SAP', 'Razorpay', 'Zoho', 'OpenAI', 'Azure', 'AWS'];

const serviceMeta: Record<string, { icon: string; skin: string; dark: boolean }> = {
  'ai-automation': { icon: 'brain', skin: 'night', dark: true },
  'custom-software-erp': { icon: 'layers', skin: 'milk', dark: false },
  'web-mobile-apps': { icon: 'device', skin: 'blue', dark: true },
  'website-design': { icon: 'globe', skin: 'white', dark: false },
  'process-automation': { icon: 'workflow', skin: 'gold', dark: false },
  'api-integration': { icon: 'plug', skin: 'ink', dark: true },
};
const industryIcons: Record<string, string> = { logistics: 'truck', 'real-estate': 'building', 'professional-services': 'scale', 'retail-ecommerce': 'cart', 'healthcare-education': 'heart', manufacturing: 'factory' };
const vignetteTones = ['blue', 'navy', 'gold', 'blue', 'navy', 'gold'];

const problems = [
  { problem: 'The business runs on spreadsheets, Tally and WhatsApp', solution: 'Business management platforms', href: '/services/custom-software-erp' },
  { problem: 'Staff re-type documents into systems all day', solution: 'Document intelligence and AI agents', href: '/services/ai-automation' },
  { problem: 'Approvals and follow-ups depend on someone remembering', solution: 'Workflow and WhatsApp automation', href: '/services/process-automation' },
  { problem: 'Customers call to ask for a status you already have', solution: 'Customer-facing apps and portals', href: '/services/web-mobile-apps' },
  { problem: 'Three systems hold three versions of the truth', solution: 'Integrations and intelligent dashboards', href: '/services/api-integration' },
  { problem: 'The website looks fine but never produces an enquiry', solution: 'Search-ready, conversion-led websites', href: '/services/website-design' },
];
const why = [
  { title: 'Business first, then code', text: 'Every engagement starts by mapping how the business actually runs. Software follows the process — not the other way round.', icon: 'workflow' },
  { title: 'Design and engineering in one room', text: 'The people who draw the screens sit with the people who write the data model, so what gets designed gets built.', icon: 'users' },
  { title: 'AI where it earns its place', text: 'Language models and OCR go where they remove hours of work, and are measured against a human baseline.', icon: 'brain' },
  { title: 'Integration is the product', text: 'Tally, SAP, Zoho, Razorpay, WhatsApp — systems that talk to each other are what make a dashboard trustworthy.', icon: 'plug' },
  { title: 'Fixed proposals, short cycles', text: 'Scope, milestones and cost agreed up front; working software every two weeks so direction changes early, not late.', icon: 'clock' },
  { title: 'A partner after launch', text: 'A support window with SLAs, then a retainer for whatever the business asks for next. The code and data are yours.', icon: 'shield' },
];
const before = [
  { title: 'A map of your process', text: 'Who does what, where it stalls and what the numbers must say at month-end — drawn with your team, not guessed.', kind: 'map' },
  { title: 'A fixed proposal', text: 'Scope, success metrics, milestones and cost on one document, shared before any commitment.', kind: 'proposal' },
  { title: 'Screens you can click', text: 'The key screens and the data model, reviewed with the people who will use them every day.', kind: 'screens' },
];
const terms = [
  { k: 'First conversation', v: 'Free' },
  { k: 'Proposal', v: 'Fixed scope and cost' },
  { k: 'Delivery', v: 'Working software every two weeks' },
  { k: 'Ownership', v: 'Code and data are yours' },
];
---
<Base {title} {description} jsonLd={[faqLd]}>
  <!-- HERO — dark, immersive -->
  <section class="hero" data-theme="navy" data-nav-dark data-zone>
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <canvas class="hero__net" data-net aria-hidden="true"></canvas>
    <div class="container hero__inner">
      <p class="hero__badge"><span class="hero__badge-dot"></span>Software, automation & AI · {site.address.locality}</p>
      <h1 class="hero__title">
        <span class="sr-only">Software that runs the business, not just the website.</span>
        <span aria-hidden="true" class="hero__line">Software that runs</span>
        <span aria-hidden="true" class="hero__line rot">{rotating.map((w, i) => <span class="rot__word" style={`--r:${i}`}>{w}</span>)}</span>
      </h1>
      <p class="body-l hero__lede">Not just the website. We build the ERP, automation and AI that replace your spreadsheets, Tally re-entry and WhatsApp follow-ups — with a fixed proposal before you commit, and code you own.</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/contact" data-magnetic>Book a free call <Icon name="arrowUp" size={16} /></a>
        <a class="btn btn--secondary" href="#services">Explore what we build</a>
      </div>
    </div>
    <div class="container hero__stage" data-tilt>
      <div class="hero__shot">
        <div class="hero__board" data-tilt-target data-theme="light"><KpiBoard title="Yard & finance board" /></div>
        <div class="hero__float hero__float--a" data-theme="light" aria-hidden="true"><span class="tile tile--green"><Icon name="check" size={18} /></span><span><strong class="label-m">Invoice posted to Tally</strong><br /><span class="label-s text-muted">2 seconds ago · no manual touch</span></span></div>
        <div class="hero__float hero__float--b" data-theme="light" aria-hidden="true"><span class="tile tile--navy"><Icon name="whatsapp" size={18} /></span><span><strong class="label-m">Lead qualified on WhatsApp</strong><br /><span class="label-s text-muted">Site visit booked for Saturday</span></span></div>
      </div>
    </div>
    <div class="container hero__meta">
      <dl class="hero__facts">
        <div><dt>Based in</dt><dd>{site.address.locality}, {site.address.region}</dd></div>
        <div><dt>Led by</dt><dd>{site.founder.name}</dd></div>
        <div><dt>Reply time</dt><dd>One business day</dd></div>
      </dl>
      <ul role="list" class="hero__platforms" aria-label="Platforms we build on and integrate with">{platforms.slice(0, 9).map((p) => <li>{p}</li>)}</ul>
    </div>
  </section>

  <!-- KINETIC TYPE BAND -->
  <div class="band-type" aria-hidden="true" data-zone>
    <div class="band-type__row">{[0, 1].map(() => <div class="band-type__track">{band1.map((w, i) => <span class={i % 2 ? 'is-outline' : ''}>{w}<b></b></span>)}</div>)}</div>
    <div class="band-type__row band-type__row--rev">{[0, 1].map(() => <div class="band-type__track">{band2.map((w, i) => <span class={i % 2 ? '' : 'is-outline'}>{w}<b></b></span>)}</div>)}</div>
  </div>

  <!-- INTRO — scrubbed statement -->
  <section class="section" aria-labelledby="intro-title">
    <div class="container intro">
      <h2 id="intro-title" class="eyebrow dot-blue">What we do</h2>
      <p class="intro__statement display-l reveal-clip" data-scrub>Most companies run on a dozen disconnected tools and a lot of WhatsApp. We replace that with one system, built around how the business actually operates. <span class="intro__soft" data-split-inner>Then we make it intelligent: documents read themselves, approvals move without chasing, and the numbers are right when the director opens the dashboard.</span></p>
    </div>
  </section>

  <!-- PROBLEMS -->
  <section class="section section--milk" id="solutions" aria-labelledby="solutions-title">
    <div class="container">
      <div class="section-head">
        <h2 id="solutions-title" class="display-xl reveal-clip">Start from the <span class="grad grad--gold">problem</span></h2>
        <p class="body-l text-secondary measure-narrow reveal">You do not need to know what to call the solution. Find the sentence that sounds like your company.</p>
      </div>
      <ol role="list" class="problems" data-stagger="3">
        {problems.map((s) => (
          <li><a class="card problem" href={s.href}>
            <span class="problem__mark" aria-hidden="true">“</span>
            <p class="problem__quote">{s.problem}.</p>
            <span class="problem__answer label-m">{s.solution} <Icon name="arrow" size={16} /></span>
          </a></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SERVICES — stacking panels -->
  <section class="section services" id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack-s"><p class="eyebrow dot-blue">Services</p><h2 id="services-title" class="display-xl reveal-clip">Six disciplines, <span class="grad grad--blue">one team</span></h2></div>
        <a class="btn btn--link reveal" href="/services">All services <Icon name="arrowUp" size={16} /></a>
      </div>
      <div class="stack">
        {services.map((s, i) => { const m = serviceMeta[s.slug]; return (
          <article class={`panel panel--${m.skin}`} style={`--i:${i}`} data-theme={m.dark ? 'navy' : 'light'}>
            <div class="panel__copy">
              <span class="panel__n">0{i + 1} <i>/ 06</i></span>
              <h3 class="panel__title">{s.name}</h3>
              <p class="body-l panel__text">{s.short}</p>
              <ul role="list" class="panel__list">{s.deliverables.map((d) => <li><Icon name="check" size={14} />{d.title}</li>)}</ul>
              <a class="btn btn--primary panel__cta" href={`/services/${s.slug}`}>See how it works <Icon name="arrowUp" size={16} /></a>
            </div>
            <div class="panel__art" aria-hidden="true">
              <span class="orbit orbit--1"></span><span class="orbit orbit--2"></span>
              <span class="panel__core"><Icon name={m.icon as any} size={44} /></span>
              {s.tech.slice(0, 5).map((t, k) => <span class={`chip chip--${k}`}>{t}</span>)}
            </div>
          </article>
        ); })}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES — pinned horizontal gallery -->
  <section class="hscroll" id="industries" data-theme="navy" data-nav-dark data-hscroll aria-labelledby="industries-title">
    <div class="hscroll__sticky">
      <div class="container hscroll__head">
        <div class="stack-s"><p class="eyebrow" style="--dot: var(--gold-600)">Industries</p><h2 id="industries-title" class="display-xl reveal-clip">Industries we know from the inside</h2></div>
        <a class="btn btn--link" href="/industries">All industries <Icon name="arrowUp" size={16} /></a>
      </div>
      <div class="hscroll__viewport">
        <div class="hscroll__track" data-hscroll-track>
          {industries.map((ind, i) => (
            <article class="slide">
              <div data-theme="light"><IndustryVignette slug={ind.slug} tone={vignetteTones[i]} /></div>
              <div class="slide__copy">
                <span class="slide__n">0{i + 1}</span>
                <h3 class="heading-m"><Icon name={industryIcons[ind.slug] as any} size={22} />{ind.name}</h3>
                <p class="body-m text-secondary">{ind.headline}</p>
                <a class="btn btn--link label-m" href={`/industries/${ind.slug}`}>{ind.shortName} in detail <Icon name="arrow" size={16} /></a>
              </div>
            </article>
          ))}
        </div>
      </div>
      <div class="container"><div class="hscroll__bar"><span data-hscroll-bar></span></div></div>
    </div>
  </section>

  <!-- BEFORE YOU COMMIT -->
  <section class="section" aria-labelledby="before-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack-s"><p class="eyebrow dot-gold">Before you commit</p><h2 id="before-title" class="display-xl reveal-clip">What you hold before you <span class="grad grad--gold">sign anything</span></h2></div>
        <p class="body-m text-secondary measure-narrow reveal">How every project is run, in writing, before work starts.</p>
      </div>
      <div class="before" data-stagger="3">
        {before.map((b) => (
          <article class="card before__card">
            <div class={`mini mini--${b.kind}`} aria-hidden="true">
              {b.kind === 'map' && <><span class="mini__node">Enquiry</span><span class="mini__node">Approve</span><span class="mini__node mini__node--gold">Invoice</span><i></i><i></i></>}
              {b.kind === 'proposal' && <><b>Proposal</b><span><em>Scope</em><i style="--w:88%"></i></span><span><em>Milestones</em><i style="--w:64%"></i></span><span><em>Cost</em><i style="--w:42%"></i></span><strong>Fixed</strong></>}
              {b.kind === 'screens' && <><span class="mini__screen"><i></i><i></i><i></i></span><span class="mini__screen mini__screen--front"><i></i><i></i><u></u></span></>}
            </div>
            <h3 class="heading-m">{b.title}</h3>
            <p class="body-m text-secondary">{b.text}</p>
          </article>
        ))}
      </div>
      <dl class="terms reveal">
        {terms.map((t) => <div><dt class="label-s text-muted">{t.k}</dt><dd class="heading-s">{t.v}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- PROCESS — pinned, scroll-scrubbed on desktop -->
  <div class="process-pin" data-pin>
    <section class="section band process-band" id="process" data-theme="navy" data-nav-dark aria-labelledby="process-title">
      <div class="aurora aurora--soft" aria-hidden="true"><i></i><i></i></div>
      <div class="container">
        <div class="section-head section-head--split">
          <div class="stack-s"><p class="eyebrow" style="--dot: var(--gold-600)">Process</p><h2 id="process-title" class="display-xl reveal-clip">How a project runs</h2></div>
          <p class="body-m text-secondary measure-narrow reveal">Six stages, each with an owner, a deliverable and a check before the next one starts.</p>
        </div>
        <ol role="list" class="timeline" data-process>
          {process.map((p) => (
            <li class="timeline__step">
              <span class="timeline__num">{p.n}</span>
              <h3 class="heading-s">{p.title}</h3>
              <p class="body-s text-secondary">{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>

  <!-- WHY -->
  <section class="section section--milk" aria-labelledby="why-title">
    <div class="container">
      <div class="section-head"><h2 id="why-title" class="display-xl reveal-clip">How we work <span class="grad grad--blue">differently</span></h2></div>
      <div class="why" data-stagger="3">
        {why.map((w, i) => (
          <article class="why__item">
            <span class="why__n">0{i + 1}</span>
            <h3 class="heading-s">{w.title}</h3>
            <p class="body-m text-secondary">{w.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Faq items={homeFaqs} intro="Short, honest answers to the questions we hear in first conversations." />
  <Cta />
</Base>

<style>
  .stack-s { display: grid; gap: 18px; }

  /* ───────── hero ───────── */
  .hero { position: relative; overflow: hidden; isolation: isolate; margin-top: calc(var(--nav-h) * -1); padding-top: calc(var(--nav-h) + clamp(40px, 6vw, 88px)); background: var(--navy-900); color: var(--text-primary); }
  .hero__net { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: .9; mask-image: linear-gradient(180deg, #000 55%, transparent); -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent); }
  .hero__inner { position: relative; display: grid; justify-items: center; text-align: center; }
  .hero__badge { display: inline-flex; align-items: center; gap: 10px; padding: 7px 14px 7px 10px; border-radius: var(--radius-pill); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(8px); font-size: var(--label-s); font-weight: 600; color: rgba(255,255,255,.82); margin-bottom: var(--space-6); animation: fade 800ms var(--ease-out) both; }
  .hero__badge-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold-600); box-shadow: 0 0 0 4px rgba(212,172,92,.25), 0 0 14px var(--gold-600); }
  .hero__title { display: grid; justify-items: center; margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(2.5rem, 1rem + 6.4vw, 6.4rem); letter-spacing: -0.045em; line-height: 1; color: var(--white); view-transition-name: page-title; }
  .hero__line { display: block; animation: rise 1000ms var(--ease-out) both; }
  .rot { display: grid; justify-items: center; animation-delay: 120ms; padding-bottom: .16em; }
  .rot__word { grid-area: 1 / 1; white-space: nowrap; background: linear-gradient(100deg, #f3dfae 0%, var(--gold-600) 45%, #7fc0ff 100%); -webkit-background-clip: text; background-clip: text; color: transparent; opacity: 0; animation: rot 12.5s var(--ease-out) infinite; animation-delay: calc(var(--r) * 2.5s); }
  @keyframes rot { 0% { opacity: 0; transform: translateY(55%) rotateX(-40deg); } 2.5%, 18% { opacity: 1; transform: none; } 20.5%, 100% { opacity: 0; transform: translateY(-55%) rotateX(40deg); } }
  @media (prefers-reduced-motion: reduce) { .rot__word { animation: none; } .rot__word:first-child { opacity: 1; } }
  .hero__lede { margin-top: var(--space-5); max-width: 40em; color: rgba(255,255,255,.74); animation: fade 800ms var(--ease-out) 360ms both; }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-6); animation: fade 800ms var(--ease-out) 480ms both; }
  .hero__stage { position: relative; margin-top: clamp(44px, 6vw, 80px); perspective: 1800px; animation: fade 1200ms var(--ease-out) 500ms both; }
  .hero__shot { position: relative; max-width: 1040px; margin-inline: auto; transform-origin: 50% 0; }
  .hero__shot::before { content: ''; position: absolute; inset: -6% -8% -10%; z-index: -1; background: radial-gradient(50% 60% at 50% 40%, rgba(35,136,242,.55), transparent 70%), radial-gradient(40% 50% at 80% 70%, rgba(212,172,92,.35), transparent 70%); filter: blur(40px); }
  .hero__board { transition: transform 500ms var(--ease-out); border-radius: 28px; }
  .hero__float { position: absolute; display: flex; gap: 12px; align-items: center; padding: 12px 16px 12px 12px; border-radius: 16px; background: var(--white); color: var(--ink-900); border: 1px solid var(--border-default); box-shadow: 0 30px 60px -20px rgba(0,0,0,.55); animation: float 7s ease-in-out infinite; text-align: left; }
  .hero__float--a { left: -70px; bottom: 18%; animation-delay: .5s; }
  .hero__float--b { right: -64px; top: 12%; animation-delay: 2s; }
  @media (max-width: 1280px) { .hero__float { display: none; } }
  .hero__meta { position: relative; display: grid; gap: var(--space-5); padding-block: clamp(36px, 5vw, 56px); }
  @media (min-width: 1000px) { .hero__meta { grid-template-columns: auto 1fr; align-items: center; gap: var(--space-8); } }
  .hero__facts { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-7); margin: 0; }
  .hero__facts dt { font-size: var(--label-s); font-weight: 600; color: rgba(255,255,255,.55); }
  .hero__facts dd { margin: 2px 0 0; font-size: var(--label-m); font-weight: 600; color: var(--white); }
  .hero__platforms { display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 15px; font-weight: 600; color: rgba(255,255,255,.5); }
  @media (min-width: 1000px) { .hero__platforms { justify-content: flex-end; } }
  @keyframes rise { from { opacity: 0; transform: translateY(0.5em); } to { opacity: 1; transform: none; } }
  @keyframes fade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 800px) {
      .hero__shot { animation: shot-flat linear both; animation-timeline: scroll(root); animation-range: 0 620px; }
      @keyframes shot-flat { from { transform: rotateX(22deg) scale(.92) translateY(10px); } to { transform: none; } }
    }
  }

  /* ───────── kinetic type band ───────── */
  .band-type { overflow: hidden; padding-block: clamp(28px, 4vw, 56px); background: var(--white); display: grid; gap: clamp(4px, 1vw, 12px); }
  .band-type__row { display: flex; width: max-content; animation: slide 40s linear infinite; }
  .band-type__row--rev { animation-direction: reverse; animation-duration: 52s; }
  .band-type__track { display: flex; flex: none; }
  .band-type span { display: inline-flex; align-items: center; font-family: var(--font-display); font-weight: 800; font-size: clamp(2.8rem, 8.5vw, 7.5rem); letter-spacing: -0.05em; line-height: 1; color: var(--ink-900); white-space: nowrap; }
  .band-type .is-outline { color: transparent; -webkit-text-stroke: 1.5px rgba(22,26,51,.55); }
  .band-type b { width: .22em; height: .22em; margin-inline: .32em; border-radius: 50%; background: var(--gold-600); }
  .band-type__row--rev span { font-size: clamp(2rem, 5.5vw, 4.6rem); color: rgba(22,26,51,.22); }
  .band-type__row--rev .is-outline { -webkit-text-stroke: 1px rgba(22,26,51,.3); color: transparent; }
  @keyframes slide { to { transform: translateX(-50%); } }

  /* ───────── intro ───────── */
  .intro { display: grid; gap: var(--space-5); align-items: start; }
  .intro > .eyebrow { margin-top: .6em; }
  @media (min-width: 900px) { .intro { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); column-gap: var(--space-9); } }
  .intro__statement { font-weight: 500; font-size: clamp(1.5rem, 1rem + 1.7vw, 2.5rem); line-height: 1.22; letter-spacing: -0.025em; max-width: 24em; text-wrap: pretty; }
  .intro__soft { color: var(--text-muted); }

  /* ───────── problems ───────── */
  .problems { display: grid; gap: var(--space-4); }
  @media (min-width: 760px) { .problems { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .problems { grid-template-columns: 1fr 1fr 1fr; } }
  .problems > li { display: grid; }
  .problem { gap: var(--space-3); padding: var(--space-6); align-content: start; min-height: 220px; overflow: hidden; }
  .problem__mark { font-family: Georgia, serif; font-size: 5rem; line-height: .7; height: 2.2rem; color: var(--gold-600); transition: transform var(--dur-slow) var(--ease-spring); transform-origin: left; }
  .problem:hover .problem__mark { transform: scale(1.25) rotate(-6deg); }
  .problem__quote { font-family: var(--font-display); font-size: 1.375rem; font-weight: 600; line-height: 1.25; letter-spacing: -0.02em; text-wrap: balance; }
  .problem__answer { display: inline-flex; align-items: center; gap: 8px; color: var(--text-accent); margin-top: auto; padding-top: var(--space-4); }
  .problem__answer :global(svg) { transition: transform var(--dur-base) var(--ease-out); }
  .problem:hover .problem__answer :global(svg) { transform: translateX(5px); }

  /* ───────── services: stacking panels ───────── */
  .stack { display: grid; gap: var(--space-5); }
