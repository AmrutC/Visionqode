---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../data/site';
const crumbs = [{ name: 'Contact', href: '/contact' }];
const ld = { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Visionqode', mainEntity: { '@id': `${site.url}/#organization` } };
const mapSrc = 'https://www.google.com/maps?q=Navi+Mumbai,+Maharashtra,+India&output=embed';
---
<Base title="Contact Visionqode — Start a Project | Navi Mumbai" description="Tell Visionqode about your project. We reply within one business day. Call or WhatsApp +91 75062 25569, email roshan@visionqode.com, or send the enquiry form." breadcrumbs={crumbs} jsonLd={[ld]}>
  <PageHeader title="Let's talk about what the business needs" lede={`A few sentences about what slows you down is enough to start. We reply ${site.replyTime}, with questions rather than a brochure.`} crumbs={crumbs} eyebrow="Contact" />
  <section class="section section--milk">
    <div class="container contact">
      <aside class="contact__aside">
        <dl class="contact__list">
          <div><dt class="label-s text-muted">Call or WhatsApp</dt><dd><a class="heading-s" href={site.phoneHref}>{site.phone}</a><br /><a class="label-m text-accent" href={site.whatsapp} target="_blank" rel="noopener">Open WhatsApp chat</a></dd></div>
          <div><dt class="label-s text-muted">Email</dt><dd><a class="heading-s" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt class="label-s text-muted">Speak to</dt><dd class="heading-s">{site.founder.name}<br /><span class="body-s text-secondary">{site.founder.role}</span></dd></div>
          <div><dt class="label-s text-muted">Office</dt><dd class="heading-s">{site.address.locality}, {site.address.region}, {site.address.countryName}<br /><span class="body-s text-secondary needs-approval">Street address to be added</span></dd></div>
          <div class="needs-approval"><dt class="label-s text-muted">Hours</dt><dd class="heading-s">Business hours to be confirmed<br /><span class="body-s text-secondary">On-site across Mumbai region; remote everywhere</span></dd></div>
        </dl>
        <div class="map">
          <iframe title="Map of Navi Mumbai, Maharashtra" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
      </aside>
      <div class="contact__form card">
        <h2 class="heading-m">Project enquiry</h2>
        <EnquiryForm />
      </div>
    </div>
  </section>
</Base>
<style>
  .contact { display: grid; gap: var(--space-8); }
  @media (min-width: 960px) { .contact { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--space-9); align-items: start; } .contact__form { order: 2; } }
  .contact__list { display: grid; gap: var(--space-5); margin: 0; }
  .contact__list dd { margin: 4px 0 0; }
  .contact__list a.heading-s:hover { color: var(--text-accent); }
  .map { margin-top: var(--space-6); aspect-ratio: 4 / 3; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border-default); filter: grayscale(1) contrast(1.05); }
  .map iframe { width: 100%; height: 100%; border: 0; }
  .contact__form { display: grid; gap: var(--space-5); }
</style>
